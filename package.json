{
  "name": "edina-boys-golf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-version.js && vite build",
    "preview": "vite preview",
    "parse-data": "node scripts/parseExcel.js",
    "update-from-sheets": "node src/scripts/importFromSheets.js",
    "update-from-sheets-with-roster": "node src/scripts/importFromSheets.js --include-roster",
    "validate": "node src/scripts/validateData.js",
    "update-and-validate": "npm run update-from-sheets && npm run validate",
    "predeploy": "bash scripts/pre-deploy-check.sh",
    "deploy": "npm run predeploy && npm run build && bash scripts/pre-deploy-check.sh",
    "postbuild": "react-snap",
    "prerender": "npm run build"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "crawl": false,
    "include": [
      "/",
      "/schedule",
      "/roster",
      "/stats",
      "/recaps",
      "/coaches",
      "/history",
      "/photos",
      "/support-team",
      "/team-info"
    ],
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    },
    "puppeteerExecutablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-onesignal": "^3.5.1",
    "react-router-dom": "^6.20.0",
    "react-snap": "^1.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
